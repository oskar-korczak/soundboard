<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ipText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connect to WiFi"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="monospace" />

        <Switch
            android:id="@+id/rateLimitSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rate Limit"
            android:textSize="12sp"
            android:checked="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/focusTimeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/focusStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Time: Inactive"
            android:textSize="12sp"
            android:textColor="#f39c12" />

        <TextView
            android:id="@+id/focusVotesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#CCCCCC"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focusTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#f39c12"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focusPolicyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#e74c3c"
            android:visibility="gone" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recentSoundsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />

</LinearLayout>
